# Copy this file to ".env" in this same directory on the server and fill in real values.
# ".env" is gitignored — never commit it.

MONGODB_URI=
SECRET_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Verified sender must match GMAIL_USER — see Settings > Senders, Domains &
# Dedicated IPs > Senders in the Brevo dashboard.
BREVO_API_KEY=
SINHALA_LLM_URL=
# Public URL the frontend is reachable at, e.g. http://<frontend-ip>:3000
FRONTEND_URL=
