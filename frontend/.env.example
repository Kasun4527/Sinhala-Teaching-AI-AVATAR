# Local dev: copy to ".env.local" (Next.js reads this automatically).
# Docker build on a server: these are NOT read from a file — pass them as
# --build-arg flags (or docker-compose "args:") when building the image,
# since NEXT_PUBLIC_* values are baked into the client bundle at build time.

NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_ENGAGEMENT_URL=
NEXT_PUBLIC_AVTR_HOST=

# Runtime-only (server-side, used in app/api/generate-tts/route.js) —
# this one DOES get read from a real .env file / --env-file at container
# run time, since it's not prefixed NEXT_PUBLIC_.
GOOGLE_API_KEY=
