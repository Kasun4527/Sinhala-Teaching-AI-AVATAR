# Copy this file to ".env" on the droplet and fill in real values.
# ".env" itself is gitignored (root .gitignore already ignores any ".env" file) — never commit it.

# --- Backend (FastAPI) ---
MONGODB_URI=
SECRET_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
SINHALA_LLM_URL=
# Public URL the frontend is reachable at, e.g. http://YOUR_DROPLET_IP:3000
FRONTEND_URL=

# --- Frontend (Next.js) ---
# Public URL the backend is reachable at, e.g. http://YOUR_DROPLET_IP:8000
# Baked into the frontend build — changing it requires "docker compose build frontend" again.
NEXT_PUBLIC_BACKEND_URL=
